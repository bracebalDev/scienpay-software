{
  "name": "scienpay-monorepo",
  "version": "1.0.0",
  "description": "Sistema de Control de Pagos y Asignaciones para Equipos de Ciencia",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@scienpay/shared",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "test:integration": "npm run build:shared && npm run build --workspace=@scienpay/api && npm run test:integration --workspace=@scienpay/api",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "lint": "node scripts/check-lint-workspaces.mjs && npm run lint --workspaces --if-present",
    "lint:fix": "eslint . --fix && npm run format",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,mjs,json,css}\" \"packages/**/*.{ts,json}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,mjs,json,css}\" \"packages/**/*.{ts,json}\" \"*.{js,json}\"",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@scienpay/api",
    "dev:web": "npm run dev --workspace=@scienpay/web",
    "dev": "npm run dev --workspaces --parallel"
  },
  "keywords": [
    "fintech",
    "pagos",
    "asignaciones",
    "ciencia",
    "clean-architecture",
    "monorepo"
  ],
  "author": "Scienpay Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.2"
  }
}
