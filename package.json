{
  "name": "scienpay-monorepo",
  "version": "1.0.0",
  "description": "Sistema de Control de Pagos y Asignaciones para Equipos de Ciencia",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@scienpay/api",
    "dev:web": "npm run dev --workspace=@scienpay/web",
    "dev": "npm run dev --workspaces --parallel"
  },
  "keywords": [
    "fintech",
    "pagos",
    "asignaciones",
    "ciencia",
    "clean-architecture",
    "monorepo"
  ],
  "author": "Scienpay Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.7.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  }
}
