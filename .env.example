# ==============================================================================
# SCIENPAY - CONFIGURACIÓN DE VARIABLES DE ENTORNO (EJEMPLO)
# REGLA: Nunca commitear archivos .env con secretos reales.
# Copiar este archivo a .env para desarrollo local: cp .env.example .env
# ==============================================================================

# ENTORNO
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# BASE DE DATOS (PostgreSQL 16+)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=scienpay_db
DATABASE_USER=scienpay_app
DATABASE_PASSWORD=scienpay_dev_password_change_me
DATABASE_URL=postgresql://scienpay_app:scienpay_dev_password_change_me@localhost:5432/scienpay_db

# SEGURIDAD Y JWT (OWASP ASVS Nivel 2)
# Generar claves criptográficas seguras de al menos 64 caracteres en producción
JWT_ACCESS_SECRET=dev_jwt_access_secret_scienpay_minimum_64_characters_super_secure_key_12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_scienpay_minimum_64_characters_super_secure_key_67890
JWT_REFRESH_EXPIRATION_DAYS=7

# COOKIES
COOKIE_SECRET=dev_cookie_secret_scienpay_super_secure_key_abcdef_987654321

# RATE LIMITING
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# FRONTEND (Vite)
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_NAME="Scienpay - Control de Pagos"
