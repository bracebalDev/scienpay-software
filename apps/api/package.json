{
  "name": "@scienpay/api",
  "version": "1.0.0",
  "description": "Backend API para Scienpay - NestJS y Drizzle ORM",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const s='src/infrastructure/database/migrations';const d='dist/infrastructure/database/migrations';fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s).filter(x=>x.endsWith('.sql')))fs.copyFileSync(p.join(s,f),p.join(d,f));\"",
    "start": "node dist/infrastructure/database/migrate.js && node dist/infrastructure/database/seed.js && node dist/main.js",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "test": "tsx --test test/domain/**/*.test.ts test/foundation/**/*.test.ts",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "test:integration": "node scripts/run-integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@scienpay/shared": "*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.6",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.17.7",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
